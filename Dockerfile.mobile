FROM python:3.12-slim
WORKDIR /app
COPY . /app
RUN pip install --no-cache-dir -r requirements.mobile.txt
RUN useradd --uid 10001 --create-home council && mkdir -p /app/data && chown -R council:council /app
USER council
EXPOSE 8001
CMD ["uvicorn", "counsel_mobile.app:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
