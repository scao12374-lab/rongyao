# Copy to .env.mobile; never commit the filled file.
MOBILE_ACCESS_TOKEN=
MOBILE_PUBLIC_ORIGIN=https://council.example.com
MOBILE_DATA_DIR=/app/data/mobile
# Model IDs must be copied from accounts you can actually access.
CHAIRMAN_MODEL=
OPENAI_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=
DOUBAO_MODEL=
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
QWEN_MODEL=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
